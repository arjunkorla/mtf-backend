# ==== FYERS API ====
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
FYERS_ACCESS_TOKEN=

# ==== Database ====
DATABASE_URL=postgresql+asyncpg://mtf:mtf@localhost:5432/mtf

# ==== Redis ====
REDIS_URL=redis://localhost:6379/0

# ==== AI Provider ====
# Supported: anthropic | none
AI_PROVIDER=none
AI_API_KEY=

# ==== App ====
APP_ENV=development
LOG_LEVEL=INFO

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8443

# Use mocked FYERS responses instead of live calls (true for local dev without credentials)
USE_MOCK_FYERS=true

# Suggestion tracker (Phase B). OFF by default; never runs with USE_MOCK_FYERS=true.
# After changing, recreate the API container: docker compose up -d --force-recreate api
ENABLE_SUGGESTION_TRACKER=false
